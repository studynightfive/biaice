# Copying this file alone is not enough to start the stack. Run scripts/init.ps1;
# it creates the ignored .env.local file and local synthetic-only credentials.
COMPOSE_PROJECT_NAME=biaice
BIAICE_IMAGE_TAG=local
BIAICE_PUBLIC_ORIGIN=http://biaice.local:8080
BIAICE_OIDC_ISSUER=http://biaice.local:8080/realms/biaice

# Only the gateway is published. Keep 0.0.0.0 for trusted-LAN testing, or use
# 127.0.0.1 for host-only access. Never put a member computer's temporary IP here.
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_HOST_PORT=8080
GATEWAY_CONTAINER_PORT=8080

POSTGRES_USER=biaice
POSTGRES_DB=biaice
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
POSTGRES_MIGRATION_USER=biaice_migrator
POSTGRES_MIGRATION_PASSWORD=__GENERATE_POSTGRES_MIGRATION_PASSWORD__
POSTGRES_RUNTIME_USER=biaice_runtime
POSTGRES_RUNTIME_PASSWORD=__GENERATE_POSTGRES_RUNTIME_PASSWORD__
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=__GENERATE_KEYCLOAK_DB_PASSWORD__

REDIS_BROKER_PASSWORD=__GENERATE_REDIS_BROKER_PASSWORD__
REDIS_CACHE_PASSWORD=__GENERATE_REDIS_CACHE_PASSWORD__
REDIS_CACHE_MAXMEMORY=512mb

MINIO_ROOT_USER=biaice-minio
MINIO_ROOT_PASSWORD=__GENERATE_MINIO_ROOT_PASSWORD__
KEYCLOAK_ADMIN_USER=biaice-bootstrap
KEYCLOAK_ADMIN_PASSWORD=__GENERATE_KEYCLOAK_ADMIN_PASSWORD__
GRAFANA_ADMIN_USER=biaice-observer
GRAFANA_ADMIN_PASSWORD=__GENERATE_GRAFANA_ADMIN_PASSWORD__

WORKER_INGEST_CONCURRENCY=2
WORKER_SIMULATION_CONCURRENCY=2
WORKER_GOVERNANCE_CONCURRENCY=1
WORKER_PROVIDER_CONCURRENCY=1
PROVIDER_EGRESS_RATE_LIMIT=30

# scripts/init.ps1 creates this ignored development password file. REAL_DATA_MODE
# backups must point to a password file outside this repository/trust domain.
BIAICE_BACKUP_PASSWORD_FILE=./infra/secrets/restic-password.txt
BIAICE_OPENBAO_OPERATOR_DIR=./infra/openbao/generated
BIAICE_PROVIDER_EGRESS_GATE_DIR=./infra/provider-egress/generated
CLAMAV_SIGNATURE_IMPORT_DIR=./infra/clamav/offline-import-placeholder

# Deliberately absent: API keys, OpenBao root tokens and unseal/recovery shares.
# They must never be placed in Compose, an env file, Git, an image, or logs.
