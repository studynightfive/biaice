{
  "name": "biaice",
  "version": "0.1.0",
  "private": true,
  "description": "标策 AI 本地自托管采购投标决策辅助系统",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:web": "npm run dev --workspace @biaice/web",
    "build": "npm run build --workspace @biaice/web",
    "start:web": "npm run start --workspace @biaice/web",
    "lint": "npm run lint --workspace @biaice/web",
    "typecheck": "npm run typecheck --workspace @biaice/web",
    "test:web": "npm run test --workspace @biaice/web",
    "test:e2e": "npm run test:e2e --workspace @biaice/web",
    "test:backend": "python -m pytest apps/backend/tests",
    "test": "npm run lint && npm run typecheck && npm run test:web && npm run test:backend",
    "contracts:export": "python packages/contracts/scripts/generate_contracts.py",
    "contracts:check": "python packages/contracts/scripts/generate_contracts.py --check",
    "contracts:report": "python scripts/contracts/check_contract_status.py"
  }
}
